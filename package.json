{
  "name": "@tubealfred/mcp",
  "version": "0.1.16",
  "description": "Bring YouTube transcripts, comments and channel data into Claude, ChatGPT and Cursor. No YouTube API key required.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "bin": {
    "tubealfred-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "plugin.json",
    ".cursor-plugin",
    "mcp.json",
    "skills"
  ],
  "scripts": {
    "build": "pnpm contract:check && tsup",
    "build:mcpb": "pnpm build && node mcpb/build.mjs",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:check": "node scripts/sync-contract.mjs --check --source contracts/tubealfred-youtube-operations.v1.json",
    "dev": "tsup --watch",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "youtube",
    "mcp",
    "mcp-server",
    "youtube-transcript",
    "transcript",
    "youtube-comments",
    "claude",
    "chatgpt",
    "cursor",
    "claude-code",
    "channel-analytics",
    "no-youtube-api-key",
    "model-context-protocol",
    "tubealfred"
  ],
  "homepage": "https://tubealfred.com",
  "bugs": {
    "url": "https://github.com/tubealfred/youtube-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tubealfred/youtube-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^25.3.5",
    "archiver": "^8.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.1.3",
      "readdir-glob>minimatch": "^11.0.1",
      "tsup>esbuild": "^0.28.1"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
